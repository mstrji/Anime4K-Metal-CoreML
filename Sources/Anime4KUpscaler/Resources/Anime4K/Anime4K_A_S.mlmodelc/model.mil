            tensor<fp16, [4, 8, 3, 3]> upscale3_weight_0 = const()[name = tensor<string, []>("upscale3_weight_0"), val = tensor<fp16, [4, 8, 3, 3]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(3776)))];
            tensor<fp16, [4]> upscale3_bias_0 = const()[name = tensor<string, []>("upscale3_bias_0"), val = tensor<fp16, [4]>([-0x1.c68p-9, -0x1.2f4p-8, -0x1.2f4p-8, -0x1.7a8p-8])];
            tensor<string, []> upscale3_pad_type_0 = const()[name = tensor<string, []>("upscale3_pad_type_0"), val = tensor<string, []>("valid")];
            tensor<int32, [2]> upscale3_strides_0 = const()[name = tensor<string, []>("upscale3_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [4]> upscale3_pad_0 = const()[name = tensor<string, []>("upscale3_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<int32, [2]> upscale3_dilations_0 = const()[name = tensor<string, []>("upscale3_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, []> upscale3_groups_0 = const()[name = tensor<string, []>("upscale3_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [1, 4, ?, ?]> upscale3 = conv(bias = upscale3_bias_0, dilations = upscale3_dilations_0, groups = upscale3_groups_0, pad = upscale3_pad_0, pad_type = upscale3_pad_type_0, strides = upscale3_strides_0, weight = upscale3_weight_0, x = upscale3_pad_cast_fp16)[name = tensor<string, []>("upscale3")];
            tensor<fp16, [1, 3, 1, 1]> luma_weight_0 = const()[name = tensor<string, []>("luma_weight_0"), val = tensor<fp16, [1, 3, 1, 1]>([[[[0x1.324p-2]], [[0x1.2c8p-1]], [[0x1.d3p-4]]]])];
            tensor<int32, [2]> luma_strides_0 = const()[name = tensor<string, []>("luma_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<string, []> luma_pad_type_0 = const()[name = tensor<string, []>("luma_pad_type_0"), val = tensor<string, []>("valid")];
            tensor<int32, [4]> luma_pad_0 = const()[name = tensor<string, []>("luma_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<int32, [2]> luma_dilations_0 = const()[name = tensor<string, []>("luma_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, []> luma_groups_0 = const()[name = tensor<string, []>("luma_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [1, 1, ?, ?]> luma = conv(dilations = luma_dilations_0, groups = luma_groups_0, pad = luma_pad_0, pad_type = luma_pad_type_0, strides = luma_strides_0, weight = luma_weight_0, x = rgb)[name = tensor<string, []>("luma")];
            tensor<int32, [2]> statsmax_kernel_sizes_0 = const()[name = tensor<string, []>("statsmax_kernel_sizes_0"), val = tensor<int32, [2]>([5, 5])];
            tensor<int32, [2]> statsmax_strides_0 = const()[name = tensor<string, []>("statsmax_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<string, []> statsmax_pad_type_0 = const()[name = tensor<string, []>("statsmax_pad_type_0"), val = tensor<string, []>("same")];
            tensor<int32, [4]> statsmax_pad_0 = const()[name = tensor<string, []>("statsmax_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<bool, []> statsmax_ceil_mode_0 = const()[name = tensor<string, []>("statsmax_ceil_mode_0"), val = tensor<bool, []>(false)];
            tensor<fp16, [1, 1, ?, ?]> statsmax = max_pool(ceil_mode = statsmax_ceil_mode_0, kernel_sizes = statsmax_kernel_sizes_0, pad = statsmax_pad_0, pad_type = statsmax_pad_type_0, strides = statsmax_strides_0, x = luma)[name = tensor<string, []>("statsmax")];
            tensor<int32, []> planes_axis_0 = const()[name = tensor<string, []>("planes_axis_0"), val = tensor<int32, []>(1)];
            tensor<bool, []> planes_interleave_0 = const()[name = tensor<string, []>("planes_interleave_0"), val = tensor<bool, []>(false)];
            tensor<fp16, [1, 8, ?, ?]> planes = concat(axis = planes_axis_0, interleave = planes_interleave_0, values = (restored, upscale3, statsmax))[name = tensor<string, []>("planes")];
        } -> (planes);
}